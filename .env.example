# ==============================================================================
# MK9 COMMAND CENTER - VARIÁVEIS DE AMBIENTE DE EXEMPLO (FRONTEND)
# Arquivo: .env.example
# ==============================================================================

# URL do projeto Supabase (acesso público do navegador)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública / publicável do Supabase (sb_publishable_... ou anon_key pública)
# IMPORTANTE: NUNCA coloque aqui chaves com papel 'service_role' ou segredos administrativos.
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica-aqui"

# URL da aplicação (usada para links e redirecionamentos)
APP_URL="http://localhost:3000"

# Chave de API opcional para assistente Gemini (se aplicável ao ambiente local)
GEMINI_API_KEY=""

