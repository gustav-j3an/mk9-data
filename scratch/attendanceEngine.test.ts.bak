import { describe, it } from 'node:test';
import assert from 'node:assert';
import type { AttendanceOverrideRecord, RouteItem, Visit } from '../types';
import {
  buildAttendanceExportRows,
  buildAttendanceRoster,
  canMutateAttendance,
  classifyLocation,
  classifyPromoterAttendance,
  DEFAULT_ATTENDANCE_RULES,
  filterAttendanceItems,
  formatTimeInTimezone,
  isOperationalDayClosed,
  isRouteScheduledOnDate,
  pickCanonicalCheckIn,
  resolveSupervisorName,
  summarizeAttendance,
  validateAttendanceOverride
} from './attendanceEngine';

const rules = {
  ...DEFAULT_ATTENDANCE_RULES,
  expectedCheckInTime: '08:00' as string | null
};

function route(overrides: Partial<RouteItem> = {}): RouteItem {
  return {
    id: 'r1',
    codigo_rota: 'ROT-001',
    industria_codigo: 'IND-001',
    loja_codigo: 'LOJ-001',
    promotor_matricula: 'PRM-001',
    uf: 'SP',
    frequencia: 'SEMANAL',
    segunda: true,
    terca: true,
    quarta: true,
    quinta: true,
    sexta: true,
    sabado: false,
    domingo: false,
    ...overrides
  };
}

function visit(overrides: Partial<Visit> = {}): Visit {
  return {
    id: 'v1',
    promotor_matricula: 'PRM-001',
    loja_codigo: 'LOJ-001',
    industria_codigo: 'IND-001',
    data_visita: '2026-10-16',
    status: 'em_andamento',
    started_at: '2026-10-16T11:05:00.000Z',
    latitude: -23.55,
    longitude: -46.63,
    ...overrides
  };
}

describe('Controle de Presença — motor de classificação', () => {
  it('promotor com expediente e check-in válido é presente e usa o horário real no fuso de São Paulo', () => {
    const result = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [visit()],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T15:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    });
    assert.strictEqual(result.operationalStatus, 'presente');
    assert.strictEqual(result.telemetryTime, formatTimeInTimezone('2026-10-16T11:05:00.000Z', 'America/Sao_Paulo'));
    assert.notStrictEqual(result.telemetryTime, '--:--');
    assert.match(result.telemetryDetail, /não validada|validada|Localização/);
  });

  it('promotor com expediente e sem check-in permanece aguardando, não falta', () => {
    const result = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T15:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    });
    assert.strictEqual(result.operationalStatus, 'aguardando_expediente');
  });

  it('promotor com expediente futuro não é falta', () => {
    const result = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [],
      operationalDate: '2026-10-20',
      nowIso: '2026-10-16T15:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    });
    assert.strictEqual(result.operationalStatus, 'expediente_futuro');
  });

  it('promotor de folga ou sem expediente não entra como falta automática', () => {
    const folga = classifyPromoterAttendance({
      scheduled: false,
      hasAnyRoute: true,
      visits: [],
      operationalDate: '2026-10-17',
      nowIso: '2026-10-17T15:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    });
    const semExpediente = classifyPromoterAttendance({
      scheduled: false,
      hasAnyRoute: false,
      visits: [],
      operationalDate: '2026-10-17',
      nowIso: '2026-10-17T15:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    });
    assert.strictEqual(folga.operationalStatus, 'folga');
    assert.strictEqual(semExpediente.operationalStatus, 'sem_expediente');
  });

  it('atraso dentro da tolerância continua presente; fora da tolerância vira atrasado', () => {
    const onTime = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [visit({ started_at: '2026-10-16T11:10:00.000Z' })],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T18:00:00.000Z',
      rules
    });
    const late = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [visit({ started_at: '2026-10-16T11:30:00.000Z' })],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T18:00:00.000Z',
      rules
    });
    assert.strictEqual(onTime.operationalStatus, 'presente');
    assert.strictEqual(late.operationalStatus, 'atrasado');
  });

  it('não marca atraso quando não existe horário de expediente configurado', () => {
    const result = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [visit({ started_at: '2026-10-16T20:00:00.000Z' })],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T21:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    });
    assert.strictEqual(result.operationalStatus, 'presente');
  });

  it('confirma falta somente após o fechamento da data operacional', () => {
    const open = classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-17T02:00:00.000Z',
      rules: { ...DEFAULT_ATTENDANCE_RULES, dayCloseTime: '23:59' }
    });
    assert.strictEqual(isOperationalDayClosed('2026-10-16', '2026-10-17T02:58:00.000Z', DEFAULT_ATTENDANCE_RULES), true);
    assert.strictEqual(open.operationalStatus, 'falta_confirmada');
  });

  it('antes da meia-noite de São Paulo o dia ainda não fecha', () => {
    // 2026-10-17T02:00:00.000Z = 16/10 23:00 em America/Sao_Paulo
    assert.strictEqual(isOperationalDayClosed('2026-10-16', '2026-10-17T02:00:00.000Z', DEFAULT_ATTENDANCE_RULES), false);
    assert.strictEqual(isOperationalDayClosed('2026-10-16', '2026-10-17T03:00:00.000Z', DEFAULT_ATTENDANCE_RULES), true);
  });

  it('atestado pendente e aprovado sobrescrevem a classificação automática', () => {
    const pendente: AttendanceOverrideRecord = {
      id: 'o1',
      promotor_matricula: 'PRM-001',
      data_operacional: '2026-10-16',
      override_status: 'atestado_pendente',
      justification: 'Atestado enviado ao RH'
    };
    const aprovado: AttendanceOverrideRecord = { ...pendente, id: 'o2', override_status: 'atestado_aprovado', medical_days: 2 };
    assert.strictEqual(classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [],
      override: pendente,
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T18:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    }).operationalStatus, 'atestado_pendente');
    assert.strictEqual(classifyPromoterAttendance({
      scheduled: true,
      hasAnyRoute: true,
      visits: [],
      override: aprovado,
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T18:00:00.000Z',
      rules: DEFAULT_ATTENDANCE_RULES
    }).operationalStatus, 'atestado_aprovado');
  });

  it('check-in duplicado conta o promotor uma vez e usa o horário mais cedo', () => {
    const canonical = pickCanonicalCheckIn([
      visit({ id: 'v2', started_at: '2026-10-16T12:40:00.000Z' }),
      visit({ id: 'v1', started_at: '2026-10-16T11:05:00.000Z', loja_codigo: 'LOJ-002' })
    ]);
    assert.strictEqual(canonical?.id, 'v1');

    const roster = buildAttendanceRoster({
      promoters: [{ id: 'p1', matricula: 'PRM-001', nome: 'Ana Silva', equipe: 'Equipe Leste', supervisor: 'Carlos', status: 'ativo' }],
      routes: [route()],
      visits: [
        visit({ id: 'v2', started_at: '2026-10-16T12:40:00.000Z' }),
        visit({ id: 'v1', started_at: '2026-10-16T11:05:00.000Z', loja_codigo: 'LOJ-002' })
      ],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T18:00:00.000Z'
    });
    assert.strictEqual(roster.length, 1);
    assert.strictEqual(roster[0].status, 'presente');
  });

  it('diferencia GPS ausente, inválido e validado somente com evidência', () => {
    const missing = classifyLocation({});
    const invalid = classifyLocation({ latitude: 0, longitude: 0 });
    const captured = classifyLocation({ latitude: -23.55, longitude: -46.63 });
    const validated = classifyLocation({
      latitude: -23.55,
      longitude: -46.63,
      storeLatitude: -23.5504,
      storeLongitude: -46.6333,
      geofenceRadiusMeters: 200
    });
    const far = classifyLocation({
      latitude: -23.55,
      longitude: -46.63,
      storeLatitude: -22.9,
      storeLongitude: -43.2,
      geofenceRadiusMeters: 200
    });
    assert.strictEqual(missing.status, 'nao_disponivel');
    assert.strictEqual(invalid.status, 'invalida');
    assert.strictEqual(captured.status, 'capturada_nao_validada');
    assert.strictEqual(validated.status, 'validada');
    assert.strictEqual(far.status, 'invalida');
  });

  it('filtros combinados e exportação usam os mesmos critérios dos indicadores', () => {
    const roster = buildAttendanceRoster({
      promoters: [
        { id: 'p1', matricula: 'PRM-001', nome: 'Ana Silva', equipe: 'Leste', supervisor: 'Carlos', cidade: 'São Paulo', uf: 'SP', status: 'ativo' },
        { id: 'p2', matricula: 'PRM-002', nome: 'Bruno Souza', equipe: 'Oeste', supervisor: 'Diana', cidade: 'Osasco', uf: 'SP', status: 'ativo' },
        { id: 'p3', matricula: 'PRM-003', nome: 'Carla Dias', equipe: 'Leste', supervisor: 'Carlos', cidade: 'Guarulhos', uf: 'SP', status: 'ativo' }
      ],
      routes: [
        route({ promotor_matricula: 'PRM-001' }),
        route({ id: 'r2', promotor_matricula: 'PRM-002' }),
        route({ id: 'r3', promotor_matricula: 'PRM-003' })
      ],
      visits: [visit({ promotor_matricula: 'PRM-001' })],
      operationalDate: '2026-10-16',
      nowIso: '2026-10-16T15:00:00.000Z'
    });

    const scoped = filterAttendanceItems(roster, { supervisor: 'Carlos', squad: 'Leste' });
    const summary = summarizeAttendance(scoped);
    const onlyMissing = filterAttendanceItems(scoped, { quickFilter: 'sem_registro' });
    const exportRows = buildAttendanceExportRows(onlyMissing);

    assert.strictEqual(scoped.length, 2);
    assert.strictEqual(summary.presentes, 1);
    assert.strictEqual(summary.semRegistro, 1);
    assert.strictEqual(onlyMissing.length, 1);
    assert.strictEqual(exportRows.length, 1);
    assert.strictEqual(exportRows[0].Matrícula, 'PRM-003');
    assert.strictEqual(exportRows[0]['Horário check-in'], '--:--');
  });

  it('bloqueia alteração de presença para perfis não autorizados', () => {
    assert.strictEqual(canMutateAttendance('operador'), false);
    assert.strictEqual(canMutateAttendance('promotor'), false);
    assert.strictEqual(canMutateAttendance('admin'), true);
    const blocked = validateAttendanceOverride({
      role: 'operador',
      overrideStatus: 'falta',
      justification: 'Falta justificada pelo RH'
    });
    const allowed = validateAttendanceOverride({
      role: 'gestor',
      overrideStatus: 'falta',
      justification: 'Falta justificada pelo RH'
    });
    assert.strictEqual(blocked.valid, false);
    assert.strictEqual(allowed.valid, true);
  });

  it('não atribui supervisor arbitrário quando o vínculo está vazio', () => {
    assert.strictEqual(resolveSupervisorName(null, 'Leste', [{ nome: 'Leste', supervisor_nome: null }]), 'Não atribuído');
    assert.strictEqual(resolveSupervisorName('', 'Leste', [{ nome: 'Leste', supervisor_nome: 'Marina' }]), 'Marina');
    assert.strictEqual(resolveSupervisorName('Paulo', 'Leste', [{ nome: 'Leste', supervisor_nome: 'Marina' }]), 'Paulo');
  });

  it('respeita escala semanal e não promove quem não está programado na data', () => {
    assert.strictEqual(isRouteScheduledOnDate(route({ sabado: false }), '2026-10-17'), false);
    assert.strictEqual(isRouteScheduledOnDate(route(), '2026-10-16'), true);

    const roster = buildAttendanceRoster({
      promoters: [
        { id: 'p1', matricula: 'PRM-001', nome: 'Ana Silva', equipe: 'Leste', status: 'ativo' },
        { id: 'p2', matricula: 'PRM-002', nome: 'Bruno Souza', equipe: 'Leste', status: 'ativo' }
      ],
      routes: [route({ promotor_matricula: 'PRM-001', sabado: false, domingo: false })],
      visits: [],
      operationalDate: '2026-10-17',
      nowIso: '2026-10-17T15:00:00.000Z'
    });
    assert.strictEqual(roster.length, 0);
  });

  it('inclui atestado mesmo fora da escala do dia e não classifica visita nao_realizada como falta imediata', () => {
    const roster = buildAttendanceRoster({
      promoters: [{ id: 'p1', matricula: 'PRM-001', nome: 'Ana Silva', equipe: 'Leste', status: 'ativo' }],
      routes: [route({ sabado: false })],
      visits: [visit({ data_visita: '2026-10-17', status: 'nao_realizada', started_at: null })],
      overrides: [{
        id: 'o1',
        promotor_matricula: 'PRM-001',
        data_operacional: '2026-10-17',
        override_status: 'atestado_pendente',
        justification: 'Atestado digital enviado'
      }],
      operationalDate: '2026-10-17',
      nowIso: '2026-10-17T15:00:00.000Z'
    });
    assert.strictEqual(roster.length, 1);
    assert.strictEqual(roster[0].operationalStatus, 'atestado_pendente');
  });
});
