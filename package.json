{
  "name": "react-example",
  "private": true,
  "version": "2.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "publication:check": "node scripts/check-publication.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:mk9": "node --import tsx --test server/mk9-faltas.test.ts",
    "test:mk9:responsive": "node tests/mk9-responsive.mjs",
    "test:mk9:bundle": "node tests/mk9-bundle-security.mjs",
    "mk9:homologation:check": "node --import tsx scripts/mk9-homologation.ts --check",
    "mk9:homologation:real": "node --import tsx scripts/mk9-homologation.ts --real",
    "rh:local:up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/mk9-rh-local.ps1 up",
    "rh:local:down": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/mk9-rh-local.ps1 down",
    "rh:local:verify": "node scripts/mk9-rh-local-verify.mjs",
    "test:faltas-atestados": "node --import tsx --test src/lib/faltasAtestados.test.ts src/lib/faltasAtestadosReceived.test.ts src/lib/absenceAttachments.test.ts src/lib/absenceAttachmentService.test.ts",
    "test:rh-integration": "node --import tsx --test server/mk9-faltas.test.ts src/lib/rhMatriculasReconciliation.test.ts",
    "security:faltas-atestados": "node tests/faltas-atestados-security.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.57.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "i": "^0.3.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "7.9.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5"
  }
}
